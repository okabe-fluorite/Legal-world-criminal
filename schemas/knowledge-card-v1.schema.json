{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simlaw.local/schemas/knowledge-card-v1.schema.json",
  "title": "CriminalLawKnowledgeCardV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "knowledge_id", "canonical_name", "domain", "chapter",
    "knowledge_type", "learning_objective", "summary", "law_article_refs",
    "standard_evidence_ids", "prerequisite_ids", "common_errors", "theory_scope",
    "review_status", "reviewer_role", "version", "law_corpus_snapshot", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "criminal-law-knowledge-card-v1"},
    "knowledge_id": {"type": "string", "pattern": "^CRIM_KP_[A-F0-9]{16}$"},
    "canonical_name": {"type": "string", "minLength": 2},
    "domain": {"const": "刑法"},
    "chapter": {"type": "string", "minLength": 2},
    "knowledge_type": {"const": "course_core"},
    "learning_objective": {"type": "string", "minLength": 10},
    "summary": {"type": "string", "minLength": 20},
    "law_article_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "standard_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVID_[A-F0-9]{20}$"}},
    "prerequisite_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CRIM_KP_[A-F0-9]{16}$"}},
    "common_errors": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 4}},
    "theory_scope": {"type": "string", "minLength": 10},
    "review_status": {"const": "pilot_teacher_approved"},
    "reviewer_role": {"type": "string", "minLength": 2},
    "version": {"type": "string", "minLength": 8},
    "law_corpus_snapshot": {"type": "string", "minLength": 8},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
