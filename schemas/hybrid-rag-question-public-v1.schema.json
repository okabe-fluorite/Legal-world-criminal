{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalworld.local/schemas/hybrid-rag-question-public-v1.schema.json",
  "title": "Hybrid RAG Public Teaching Question",
  "type": "object",
  "required": [
    "schema_version",
    "question_id",
    "visibility",
    "retrieval_tier",
    "source_dataset",
    "subject",
    "question_type",
    "stem",
    "options",
    "embed_text",
    "source_path",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "hybrid-rag-question-public-v1" },
    "question_id": { "type": "string", "minLength": 1 },
    "visibility": { "const": "public" },
    "retrieval_tier": { "const": "question_teaching_public" },
    "source_dataset": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "question_type": { "type": "string", "minLength": 1 },
    "stem": { "type": "string", "minLength": 1 },
    "options": { "type": "object", "additionalProperties": { "type": "string" } },
    "embed_text": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string", "minLength": 1 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "not": {
    "anyOf": [
      { "required": ["answer_private"] },
      { "required": ["rationale_private"] },
      { "required": ["misconceptions_private"] },
      { "required": ["rubric_private"] },
      { "required": ["expected_points_private"] }
    ]
  },
  "additionalProperties": true
}
