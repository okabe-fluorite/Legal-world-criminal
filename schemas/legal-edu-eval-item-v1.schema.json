{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simlaw.local/schemas/legal-edu-eval-item-v1.schema.json",
  "title": "LegalEduEvalItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "task_type", "subtype", "domain", "source_family_id",
    "split", "input", "standard_evidence", "required_points", "forbidden_outputs",
    "risk_labels", "automatic_metrics", "human_rubric", "review", "provenance",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legal-edu-eval-item-v1"},
    "task_id": {"type": "string", "pattern": "^LEEV1_[A-F0-9]{20}$"},
    "task_type": {
      "enum": [
        "law_source_qa", "issue_subsumption", "pro_con_reasoning",
        "teaching_feedback", "safety_abstention"
      ]
    },
    "subtype": {"type": "string", "minLength": 2},
    "domain": {"const": "本科刑法"},
    "source_family_id": {"type": "string", "minLength": 3},
    "split": {"enum": ["dev", "test"]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "question", "context", "student_text"],
      "properties": {
        "instruction": {"type": "string", "minLength": 4},
        "question": {"type": "string", "minLength": 4},
        "context": {"type": "object"},
        "student_text": {"type": "string"}
      }
    },
    "standard_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id", "source_title", "article_ref", "quote", "effective_from",
          "source_bundle_sha256"
        ],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVID_[A-F0-9]{20}$"},
          "source_title": {"type": "string", "minLength": 2},
          "article_ref": {"type": "string", "minLength": 2},
          "quote": {"type": "string", "minLength": 2},
          "effective_from": {"type": ["string", "null"]},
          "source_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "required_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "label", "keyword_groups"],
        "properties": {
          "point_id": {"type": "string", "minLength": 2},
          "label": {"type": "string", "minLength": 2},
          "keyword_groups": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "array", "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "forbidden_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "automatic_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "human_rubric": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "max_score", "anchor"],
        "properties": {
          "dimension": {"type": "string", "minLength": 2},
          "max_score": {"type": "integer", "minimum": 1, "maximum": 5},
          "anchor": {"type": "string", "minLength": 4}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "legal_reviewer", "reviewed_at", "gold_status"],
      "properties": {
        "status": {"const": "candidate_requires_legal_review"},
        "legal_reviewer": {"type": "null"},
        "reviewed_at": {"type": "null"},
        "gold_status": {"const": "not_gold"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "source_kind", "source_ids", "license_review_status"],
      "properties": {
        "generator": {"const": "build_legal_edu_eval_v1.py"},
        "source_kind": {"type": "string", "minLength": 2},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "license_review_status": {"enum": ["internal_governed_content", "requires_source_license_review"]}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
