{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simlaw.local/schemas/legal-reasoning-v1.schema.json",
  "title": "LegalReasoningV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "reasoning_id", "case_context", "issue", "facts",
    "rules", "applications", "counterarguments", "conclusion", "uncertainty", "safety"
  ],
  "$defs": {
    "factId": {"type": "string", "pattern": "^FACT_[A-Z0-9_]{2,64}$"},
    "evidenceId": {"type": "string", "pattern": "^EVID_[A-F0-9]{20}$"},
    "elementId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,64}$"},
    "nonEmptyStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "properties": {
    "schema_version": {"const": "legal-reasoning-v1"},
    "reasoning_id": {"type": "string", "pattern": "^LR_[A-F0-9]{20}$"},
    "case_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_bundle_id", "case_bundle_version", "stage",
        "student_visible_sha256", "evidence_scope_id"
      ],
      "properties": {
        "case_bundle_id": {"type": "string", "pattern": "^CRIM_CASE_[A-F0-9]{20}$"},
        "case_bundle_version": {"type": "string", "minLength": 1},
        "stage": {"enum": ["LC", "INV", "PR", "DS", "CR", "CRA"]},
        "student_visible_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_scope_id": {"type": "string", "pattern": "^SCOPE_[A-F0-9]{20}$"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "issue_type"],
      "properties": {
        "statement": {"type": "string", "minLength": 4},
        "issue_type": {
          "enum": ["criminal_liability", "justification", "procedure", "sentencing", "other"]
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "statement", "source_path", "source_quote", "status"],
        "properties": {
          "fact_id": {"$ref": "#/$defs/factId"},
          "statement": {"type": "string", "minLength": 2},
          "source_path": {
            "type": "string",
            "pattern": "^student_visible(?:\\.[a-zA-Z0-9_]+|\\[[0-9]+\\])+$"
          },
          "source_quote": {"type": "string", "minLength": 1},
          "status": {"enum": ["agreed", "disputed", "alleged", "unknown"]}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id", "statement", "evidence_id", "source_title", "article_ref", "quote"
        ],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^RULE_[A-Z0-9_]{2,64}$"},
          "statement": {"type": "string", "minLength": 2},
          "evidence_id": {"$ref": "#/$defs/evidenceId"},
          "source_title": {"type": "string", "minLength": 2},
          "article_ref": {"type": "string", "minLength": 2},
          "quote": {"type": "string", "minLength": 2}
        }
      }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id", "element", "fact_ids", "evidence_ids", "analysis", "finding"
        ],
        "properties": {
          "element_id": {"$ref": "#/$defs/elementId"},
          "element": {"type": "string", "minLength": 2},
          "fact_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "#/$defs/factId"}
          },
          "evidence_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidenceId"}
          },
          "analysis": {"type": "string", "minLength": 4},
          "finding": {"enum": ["satisfied", "not_satisfied", "disputed", "insufficient"]}
        }
      }
    },
    "counterarguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argument_id", "position", "fact_ids", "evidence_ids", "response", "unresolved"
        ],
        "properties": {
          "argument_id": {"type": "string", "pattern": "^COUNTER_[A-Z0-9_]{2,64}$"},
          "position": {"type": "string", "minLength": 4},
          "fact_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "#/$defs/factId"}
          },
          "evidence_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidenceId"}
          },
          "response": {"type": "string", "minLength": 4},
          "unresolved": {"type": "boolean"}
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "statement", "fact_ids", "evidence_ids", "confidence"],
      "properties": {
        "status": {"enum": ["supported_tentative", "supported_strong", "abstain"]},
        "statement": {"type": "string", "minLength": 4},
        "fact_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/factId"}
        },
        "evidence_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status", "missing_facts", "missing_evidence", "disputed_points",
        "teacher_review_required"
      ],
      "properties": {
        "evidence_status": {"enum": ["sufficient", "limited", "insufficient"]},
        "missing_facts": {"$ref": "#/$defs/nonEmptyStringArray"},
        "missing_evidence": {"$ref": "#/$defs/nonEmptyStringArray"},
        "disputed_points": {"$ref": "#/$defs/nonEmptyStringArray"},
        "teacher_review_required": {"type": "boolean"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["untrusted_instruction_detected", "ai_generated", "intended_use"],
      "properties": {
        "untrusted_instruction_detected": {"type": "boolean"},
        "ai_generated": {"const": true},
        "intended_use": {"const": "formative_education"}
      }
    }
  }
}
