{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalworld.local/schemas/hybrid-rag-source-manifest-v1.schema.json",
  "title": "Hybrid RAG Source Manifest Row",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "document_id",
    "source_type",
    "title",
    "source_path",
    "source_file_sha256",
    "document_content_sha256",
    "is_canonical"
  ],
  "properties": {
    "schema_version": { "const": "hybrid-rag-source-manifest-v1" },
    "source_id": { "type": "string", "pattern": "^RAGS_[A-F0-9]{24}$" },
    "document_id": { "type": "string", "pattern": "^RAGD_[A-F0-9]{24}$" },
    "source_type": { "enum": ["law", "regulation", "judicial_interpretation", "case"] },
    "title": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string", "pattern": "^laws/" },
    "source_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "document_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "is_canonical": { "type": "boolean" }
  },
  "additionalProperties": true
}
