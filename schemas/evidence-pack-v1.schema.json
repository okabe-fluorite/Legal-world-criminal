{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simlaw.local/schemas/evidence-pack-v1.schema.json",
  "title": "EvidencePackV1",
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": [
        "schema_version", "evidence_id", "source_type", "document_id", "title",
        "source_title", "article_ref", "quote", "authority_level", "effective_from",
        "effective_to", "effective_status", "source_url", "source_url_scope",
        "source_snapshot_id", "source_bundle_sha256", "risk_flags"
      ],
      "properties": {
        "schema_version": {"const": "evidence-pack-item-v1"},
        "evidence_id": {"type": "string", "pattern": "^EVID_[A-F0-9]{20}$"},
        "source_type": {"enum": ["法律条文", "law", "administrative_regulation", "judicial_interpretation", "judicial_normative_document", "guiding_case", "typical_case", "textbook_explanation", "learning_resource"]},
        "document_id": {"type": "string", "minLength": 2},
        "title": {"type": "string", "minLength": 2},
        "source_title": {"type": "string", "minLength": 2},
        "article_ref": {"type": "string"},
        "quote": {"type": "string", "minLength": 2},
        "authority_level": {"type": "string", "minLength": 1},
        "effective_from": {"type": ["string", "null"]},
        "effective_to": {"type": ["string", "null"]},
        "effective_status": {"type": "string", "minLength": 2},
        "source_url": {"type": "string"},
        "source_url_scope": {"type": "string", "minLength": 2},
        "source_snapshot_id": {"type": "string", "minLength": 2},
        "source_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "risk_flags": {"type": "array", "items": {"type": "string"}},
        "relevance": {"type": "number", "minimum": 0},
        "match_reasons": {"type": "array", "items": {"type": "string"}},
        "allowed_usage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["normative_rule", "judicial_application", "case_reference", "teaching_explanation", "learning_resource"]}},
        "document_number": {"type": "string"},
        "parent_context": {"type": ["object", "null"]},
        "issuing_authority": {"type": "string"},
        "promulgated_date": {"type": "string"},
        "effective_date": {"type": "string"},
        "expiry_date": {"type": "string"},
        "version": {"type": "string"},
        "official_source_url": {"type": "string"},
        "verification_method": {"type": "string"},
        "verification_status": {"enum": ["verified", "partially_verified", "unresolved", "legacy_governed_core"]},
        "source_use": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "query_id", "task_type", "query", "knowledge_ids",
    "evidences", "coverage", "source_snapshot", "generated_at", "warnings"
  ],
  "properties": {
    "schema_version": {"const": "evidence-pack-v1"},
    "query_id": {"type": "string", "pattern": "^Q_[A-F0-9]{20}$"},
    "task_type": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "knowledge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidences": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "coverage": {"type": "object"},
    "source_snapshot": {"type": "object"},
    "generated_at": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "usage_policy": {"type": "object"},
    "knowledge_context": {"type": "object"}
  }
}
