OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL_NAME=
SIMLAW_PROMPT_PROFILE=prod

# Optional automatic fallback. The primary OPENAI_* endpoint is always tried
# first. Only transient failures (429/rate limit, 502-504, timeout/connection)
# open the process-local circuit and route subsequent calls here. 401/400 and
# other configuration errors do not fall back silently.
SIMLAW_FALLBACK_MODEL_API_KEY=
SIMLAW_FALLBACK_MODEL_API_BASE_URL=https://api.deepseek.com
SIMLAW_FALLBACK_MODEL_NAME=deepseek-v4-flash-vision-exp
SIMLAW_FALLBACK_MODEL_TIMEOUT_SECONDS=180
SIMLAW_FALLBACK_CIRCUIT_SECONDS=900

# Optional OpenAI-compatible fine-tuned/local small model.  The business code
# routes only the listed tasks to this endpoint and keeps every other task on
# OPENAI_* above. Supported tasks:
# agent, teaching_judge, citation_alignment, response_assist,
# document_assist, closing_summary, eval
SIMLAW_SMALL_MODEL_API_KEY=
SIMLAW_SMALL_MODEL_API_BASE_URL=
SIMLAW_SMALL_MODEL_NAME=
SIMLAW_SMALL_MODEL_TASKS=
SIMLAW_SMALL_MODEL_TIMEOUT_SECONDS=180

# Optional per-task override (example for a dedicated scoring model).  The
# same NAME/API_BASE_URL/API_KEY/TIMEOUT_SECONDS suffixes work for every task.
SIMLAW_MODEL_TEACHING_JUDGE_NAME=
SIMLAW_MODEL_TEACHING_JUDGE_API_BASE_URL=
SIMLAW_MODEL_TEACHING_JUDGE_API_KEY=
SIMLAW_MODEL_TEACHING_JUDGE_TIMEOUT_SECONDS=180
# Per-task fallback uses FALLBACK_NAME/FALLBACK_API_BASE_URL/
# FALLBACK_API_KEY/FALLBACK_TIMEOUT_SECONDS with the same task prefix.

# Optional EduBrain adaptive service.  When unset, the application keeps the
# local evidence-aware fallback profile and recommendation UI.
SIMLAW_ADAPTIVE_API_BASE_URL=
SIMLAW_ADAPTIVE_API_KEY=
SIMLAW_ADAPTIVE_EVENTS_PATH=/events
SIMLAW_ADAPTIVE_RECOMMEND_PATH=/recommend
SIMLAW_ADAPTIVE_TIMEOUT_SECONDS=15

# Law retrieval is disabled by default in the public repository because the
# vector index is a large external data asset. Enable it only after downloading
# and unpacking the law index from the project Data page.
SIMLAW_ENABLE_LAW_RETRIEVAL=false
LAW_RETRIEVAL_INDEX_DIR=
LAW_EMBEDDING_API_KEY=
LAW_EMBEDDING_API_BASE_URL=
LAW_EMBEDDING_MODEL=
LAW_EMBEDDING_DIMENSIONS=1024

# 元典法律 MCP（法条溯源/案例检索）
YUANDIAN_API_KEY=
YUANDIAN_BASE_URL=https://open.chineselaw.com
YUANDIAN_TIMEOUT_SECONDS=40

POSTGRES_DB=simlaw
POSTGRES_USER=simlaw
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://simlaw:change-this-postgres-password@postgres:5432/simlaw
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

JWT_SECRET=change-this-jwt-secret-at-least-32-bytes
JWT_EXPIRES_MINUTES=60
SIMLAW_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SIMLAW_ENABLE_LEGACY_SIMULATION_API=false
SIMLAW_ENABLE_DEBUG_UI=false
# Legacy query-string WebSocket tokens leak into access logs; keep disabled.
SIMLAW_ALLOW_WS_QUERY_TOKEN=false
SIMLAW_TEACHING_ASYNC_STAGE_ATTEMPTS=3
SIMLAW_TEACHING_ASYNC_RETRY_SECONDS=30,120

# Optional Python package index override for backend image builds.
UV_INDEX_URL=

BACKEND_PORT=8000
FRONTEND_PORT=5173
MAX_CONCURRENT_CASES=1
SIMLAW_SANDBOX_DATA_DIR=
SIMLAW_SANDBOX_SEED_DIR=
